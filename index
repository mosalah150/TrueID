<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrueID Game Hub - Executive Performance Dashboard</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Kanit', sans-serif; background-color: #0f172a; }
    </style>
</head>
<body class="text-slate-100 min-h-screen pb-12">

    <!-- Header Navigation -->
    <header class="bg-slate-900/80 backdrop-blur border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-red-600 text-white font-bold text-xl px-3 py-1 rounded-lg">TrueID</div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white">Game Hub Executive Dashboard</h1>
                    <p class="text-xs text-slate-400">การวิเคราะห์ผลการดำเนินงานเชิงลึก (Oct 2025 - Aug 2026)</p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <span class="bg-slate-800 text-slate-300 text-xs px-3 py-1.5 rounded-full border border-slate-700">
                    <i class="fa-solid fa-clock-rotate-left mr-1 text-red-500"></i> ข้อมูลสะสม 10 เดือน
                </span>
                <button onclick="window.print()" class="bg-red-600 hover:bg-red-700 text-white px-3.5 py-1.5 rounded-lg text-xs font-semibold transition">
                    <i class="fa-solid fa-print mr-1"></i> พิมพ์รายงาน
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">

        <!-- Executive KPI Highlight Cards -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Card 1: Total Impressions -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 backdrop-blur">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-slate-400">Total Impressions</p>
                        <h3 class="text-2xl font-bold text-white mt-1">25.16M</h3>
                    </div>
                    <div class="p-2.5 bg-emerald-500/10 text-emerald-400 rounded-lg">
                        <i class="fa-solid fa-eye text-lg"></i>
                    </div>
                </div>
                <p class="text-xs text-emerald-400 mt-3 flex items-center">
                    <i class="fa-solid fa-circle-check mr-1"></i> ทะลุเป้าหมาย Q1 KPI (20M)
                </p>
            </div>

            <!-- Card 2: Total Clicks -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 backdrop-blur">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-slate-400">Accumulated Clicks</p>
                        <h3 class="text-2xl font-bold text-white mt-1">307,575</h3>
                    </div>
                    <div class="p-2.5 bg-blue-500/10 text-blue-400 rounded-lg">
                        <i class="fa-solid fa-arrow-pointer text-lg"></i>
                    </div>
                </div>
                <p class="text-xs text-blue-400 mt-3 flex items-center">
                    <i class="fa-solid fa-chart-line mr-1"></i> เฉลี่ย CTR ภาพรวม 1.22%
                </p>
            </div>

            <!-- Card 3: Accumulated Revenue -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 backdrop-blur">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-slate-400">Accumulated Revenue</p>
                        <h3 class="text-2xl font-bold text-amber-400 mt-1">฿46,033</h3>
                    </div>
                    <div class="p-2.5 bg-amber-500/10 text-amber-400 rounded-lg">
                        <i class="fa-solid fa-sack-dollar text-lg"></i>
                    </div>
                </div>
                <p class="text-xs text-amber-400 mt-3 flex items-center">
                    <i class="fa-solid fa-receipt mr-1"></i> คำสั่งซื้อรวมสำเร็จ 186 Orders
                </p>
            </div>

            <!-- Card 4: Critical Drop-off Rate -->
            <div class="bg-slate-800/60 border border-rose-500/50 rounded-xl p-5 backdrop-blur relative overflow-hidden">
                <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-rose-500/10 rounded-full blur-xl"></div>
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-rose-400">Checkout Drop-off Rate</p>
                        <h3 class="text-2xl font-bold text-rose-500 mt-1">97.10%</h3>
                    </div>
                    <div class="p-2.5 bg-rose-500/10 text-rose-400 rounded-lg">
                        <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                    </div>
                </div>
                <p class="text-xs text-rose-400 mt-3 flex items-center font-medium">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i> วิกฤต: ผู้ใช้หลุดช่วงชำระเงินสูงมาก
                </p>
            </div>
        </section>

        <!-- Key Strategic Insights Section -->
        <section class="bg-slate-800/80 border border-slate-700 rounded-xl p-6">
            <h2 class="text-lg font-bold text-white mb-4 flex items-center">
                <i class="fa-solid fa-lightbulb text-amber-400 mr-2"></i> Key Executive Insights & Data Findings
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
                <div class="bg-slate-900/60 p-4 rounded-lg border border-slate-800 space-y-2">
                    <span class="text-xs font-semibold text-blue-400 uppercase tracking-wider">1. Media Performance</span>
                    <h4 class="font-bold text-white">Reach สูง แต่ Low Conversion</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">
                        สื่อ App Push และ Boost Up สร้าง Impressions รวมได้หลายล้านครั้งต่อเดือน แต่มี CTR ต่ำกว่า 0.5% แสดงว่าผู้รับสื่อยังไม่ใช่กลุ่ม Target เปอร์เซ็นต์ผู้ซื้อจริงอยู่ที่เพียง 0.08%
                    </p>
                </div>
                <div class="bg-slate-900/60 p-4 rounded-lg border border-slate-800 space-y-2">
                    <span class="text-xs font-semibold text-purple-400 uppercase tracking-wider">2. Product Demand</span>
                    <h4 class="font-bold text-white">Mobile Games ครองตาราง</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">
                        ผู้ใช้ TrueID นิยมเติมเกม Mobile eSports อย่าง <strong>Free Fire, ROV</strong> และ <strong>Roblox</strong> สูงที่สุด ในขณะที่ PC/Console Game Keys มียอดคลิกน้อยกว่าอย่างเห็นได้ชัด
                    </p>
                </div>
                <div class="bg-slate-900/60 p-4 rounded-lg border border-slate-800 space-y-2">
                    <span class="text-xs font-semibold text-rose-400 uppercase tracking-wider">3. Critical Bottleneck</span>
                    <h4 class="font-bold text-white">Payment Flow คอขวดสัดส่วน 97%</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">
                        ยอด Order ในหมวด Top Up มีการสร้างขึ้นถึง 263 รายการ แต่ทำรายการสำเร็จจริงเพียง 6 รายการ (อีก 257 รายการล้มเหลว) ต้องเร่งแก้ไขปัญหา Payment Gateway โดยด่วน
                    </p>
                </div>
            </div>
        </section>

        <!-- Charts Grid -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Chart 1: Top Games Traffic Comparison -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6">
                <h3 class="text-base font-bold text-white mb-1">Top Performing Games (Weekly Clicks)</h3>
                <p class="text-xs text-slate-400 mb-4">เปรียบเทียบความสนใจของผู้ใช้งานแยกตามรายเกม (สัปดาห์ล่าสุด)</p>
                <div class="h-64 relative">
                    <canvas id="topGamesChart"></canvas>
                </div>
            </div>

            <!-- Chart 2: Order Status Breakdown -->
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6">
                <h3 class="text-base font-bold text-white mb-1">Top Up Order Completion Status</h3>
                <p class="text-xs text-slate-400 mb-4">สัดส่วนคำสั่งซื้อที่สำเร็จ vs ไม่สำเร็จ ในหมวด เติมเกม (Top up)</p>
                <div class="h-64 relative flex justify-center items-center">
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
        </section>

        <!-- Detailed Comparison Table -->
        <section class="bg-slate-800/60 border border-slate-700/60 rounded-xl overflow-hidden">
            <div class="p-6 border-b border-slate-700/60">
                <h3 class="text-base font-bold text-white">Product Category Breakdown</h3>
                <p class="text-xs text-slate-400">สรุปเปรียบเทียบผลงานระหว่างหมวดหมู่ Game Key และ Top Up</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-900/80 text-xs text-slate-400 uppercase font-semibold">
                        <tr>
                            <th class="py-3.5 px-6">หมวดหมู่สินค้า</th>
                            <th class="py-3.5 px-4 text-center">Total Orders</th>
                            <th class="py-3.5 px-4 text-center">Success</th>
                            <th class="py-3.5 px-4 text-center">Unsuccess / Pending</th>
                            <th class="py-3.5 px-4 text-right">Revenue (THB)</th>
                            <th class="py-3.5 px-4 text-center">Drop-off %</th>
                            <th class="py-3.5 px-6">Top Game SKU</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700/60">
                        <tr class="hover:bg-slate-700/30">
                            <td class="py-4 px-6 font-semibold text-white flex items-center space-x-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                                <span>Game Key</span>
                            </td>
                            <td class="py-4 px-4 text-center">47 Orders</td>
                            <td class="py-4 px-4 text-center"><span class="bg-emerald-500/20 text-emerald-400 px-2.5 py-1 rounded-full text-xs font-semibold">3 Orders</span></td>
                            <td class="py-4 px-4 text-center"><span class="bg-amber-500/20 text-amber-400 px-2.5 py-1 rounded-full text-xs">44 Pending</span></td>
                            <td class="py-4 px-4 text-right font-bold text-white">฿963</td>
                            <td class="py-4 px-4 text-center text-rose-400 font-semibold">93.6%</td>
                            <td class="py-4 px-6 text-slate-400">Roblox Gift Card 300 THB</td>
                        </tr>
                        <tr class="hover:bg-slate-700/30">
                            <td class="py-4 px-6 font-semibold text-white flex items-center space-x-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
                                <span>Game Top up</span>
                            </td>
                            <td class="py-4 px-4 text-center">263 Orders</td>
                            <td class="py-4 px-4 text-center"><span class="bg-emerald-500/20 text-emerald-400 px-2.5 py-1 rounded-full text-xs font-semibold">6 Orders</span></td>
                            <td class="py-4 px-4 text-center"><span class="bg-rose-500/20 text-rose-400 px-2.5 py-1 rounded-full text-xs">257 Failed</span></td>
                            <td class="py-4 px-4 text-right font-bold text-white">฿1,450</td>
                            <td class="py-4 px-4 text-center text-rose-400 font-semibold">97.7%</td>
                            <td class="py-4 px-6 text-slate-400">Free Fire, ROV, MLBB, Valorant</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <script>
        // Chart 1: Top Games Chart
        const ctxGames = document.getElementById('topGamesChart').getContext('2d');
        new Chart(ctxGames, {
            type: 'bar',
            data: {
                labels: ['Free Fire', 'ROV', 'Roblox', 'Racing Master', 'EA FC Mobile', 'PUBG Mobile'],
                datasets: [{
                    label: 'Clicks',
                    data: [509, 380, 189, 94, 58, 44],
                    backgroundColor: [
                        '#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#06b6d4'
                    ],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: '#94a3b8' }, grid: { display: false } },
                    y: { ticks: { color: '#94a3b8' }, grid: { color: '#334155' } }
                }
            }
        });

        // Chart 2: Order Status Doughnut Chart
        const ctxOrder = document.getElementById('orderStatusChart').getContext('2d');
        new Chart(ctxOrder, {
            type: 'doughnut',
            data: {
                labels: ['สำเร็จ (Success Orders)', 'ล้มเหลว (Unsuccess / Failed)'],
                datasets: [{
                    data: [6, 257],
                    backgroundColor: ['#10b981', '#f43f5e'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#e2e8f0', font: { family: 'Kanit' } }
                    }
                },
                cutout: '75%'
            }
        });
    </script>
</body>
</html>
